{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${LR_WEAPONS_VERSION}",
	"name": "lr_weapons",
	"description": "[LR] ExStats Weapons: per-weapon kill statistics of the Levels Ranks core (the `<lr_table>_weapons` table: steam, classname, kills), the per-weapon experience coefficient of exstats_weapons.ini and the per-kill / on-disconnect saves. Ported from the Pisex Levels Ranks module LR_ExStatsWeapons (production plugin lr_weapons). Owns its plgdb connection with the levels_ranks database settings. Requires the levels_ranks core; no exported methods.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/lr_weapons",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "levels_ranks",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
